# --- تلگرام: نمونه ۱ (ربات اصلی ORB — settings.yaml) ---
TELEGRAM_TOKEN=توکن-ربات-اول-را-از-BotFather-اینجا-بگذارید

# --- تلگرام: نمونه ۲ (ربات آیچیموکو — settings_ichimoku.yaml) ---
# در settings_ichimoku.yaml فیلد token_env همین نام را می‌خواند؛
# اولویتش از TELEGRAM_TOKEN عمومی بالاتر است (FIX).
TELEGRAM_TOKEN_ICHIMOKU=توکن-ربات-دوم-را-از-BotFather-اینجا-بگذارید

# --- اختیاری: لاگین ترمینال MT5 (اگر ترمینال از قبل لاگین است، لازم نیست) ---
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
# MT5_PATH=

# --- فقط سیستم ایران (پروکسی تلگرام) — روی VPS خارج ننویسید ---
# TELEGRAM_PROXY=http://127.0.0.1:10808